# Salin file ini menjadi .env.local untuk pengembangan lokal,
# dan masukkan variabel yang sama di Vercel -> Project Settings -> Environment Variables.

# Opsional: Aktifkan mode file dummy lokal (tanpa koneksi Supabase) untuk coba-coba/testing lokal
# USE_LOCAL_DB=true

# Dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9_REPLACE_WITH_YOUR_SERVICE_ROLE_KEY

# Buat string acak panjang minimal 32 karakter (misal: openssl rand -hex 32)
SESSION_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter_aman
